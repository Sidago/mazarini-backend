{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link",
    "description": "Reusable link with text, URL, and variant"
  },
  "options": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "enum": ["primary", "outline", "text"],
      "default": "text"
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    }
  }
}
