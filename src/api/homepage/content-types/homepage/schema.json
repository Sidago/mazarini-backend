{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage content including hero, stats, and CTA sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroBadge": {
      "type": "string"
    },
    "heroTitle": {
      "type": "string",
      "required": true
    },
    "heroHighlightText": {
      "type": "string"
    },
    "heroSubtitle": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "heroFeatured": {
      "type": "component",
      "component": "shared.hero-featured",
      "repeatable": false
    },
    "heroCTAs": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "stats": {
      "type": "component",
      "component": "shared.stat",
      "repeatable": true
    },
    "expertiseHeading": {
      "type": "string"
    },
    "expertiseSubheading": {
      "type": "string"
    },
    "projectsHeading": {
      "type": "string"
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "ctaTitle": {
      "type": "string"
    },
    "ctaHighlightWord": {
      "type": "string"
    },
    "ctaSubtitle": {
      "type": "text"
    },
    "ctaCTAs": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    }
  }
}
