{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage content including hero, stats, and CTA sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroBadge": {
      "type": "string"
    },
    "heroTitle": {
      "type": "string",
      "required": true
    },
    "heroHighlightText": {
      "type": "string"
    },
    "heroSubtitle": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "heroVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "heroFeatured": {
      "type": "component",
      "component": "shared.hero-featured",
      "repeatable": false
    },
    "heroCTAs": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "stats": {
      "type": "component",
      "component": "shared.stat",
      "repeatable": true
    },
    "introHeading": {
      "type": "text"
    },
    "introHighlightText": {
      "type": "string"
    },
    "introDescription": {
      "type": "text"
    },
    "expertiseHeading": {
      "type": "string"
    },
    "expertiseSubheading": {
      "type": "string"
    },
    "projectsHeading": {
      "type": "string"
    },
    "expertise": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::expertise.expertise"
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial"
    },
    "ctaTitle": {
      "type": "string"
    },
    "ctaHighlightWord": {
      "type": "string"
    },
    "ctaSubtitle": {
      "type": "text"
    },
    "ctaCTAs": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service"
    },
    "our_clients": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::our-client.our-client"
    },
    "experienceHeading": {
      "type": "text"
    },
    "experienceHighlightText": {
      "type": "string"
    },
    "experienceDescription": {
      "type": "text"
    },
    "experienceImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "experienceCtaText": {
      "type": "string"
    },
    "belongHeading": {
      "type": "string"
    },
    "belongDescription": {
      "type": "text"
    },
    "belongImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "belongCtaText": {
      "type": "string"
    }
  }
}
