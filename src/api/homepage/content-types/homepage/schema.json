{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage content including hero, stats, and CTA sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroBadge": {
      "type": "string"
    },
    "heroTitle": {
      "type": "string",
      "required": true
    },
    "heroHighlightText": {
      "type": "string"
    },
    "heroSubtitle": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "heroFeatured": {
      "type": "component",
      "repeatable": false,
      "component": "shared.hero-featured"
    },
    "heroCTAs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "expertiseHeading": {
      "type": "string"
    },
    "expertiseSubheading": {
      "type": "string"
    },
    "projectsHeading": {
      "type": "string"
    },
    "ctaTitle": {
      "type": "string"
    },
    "ctaHighlightWord": {
      "type": "string"
    },
    "ctaSubtitle": {
      "type": "text"
    },
    "ctaCTAs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    }
  }
}
