{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Site-wide settings, navigation, footer, and SEO"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "siteDescription": {
      "type": "text"
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "navLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "headerCtaText": {
      "type": "string"
    },
    "headerCtaUrl": {
      "type": "string"
    },
    "footerDescription": {
      "type": "text"
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.footer-column"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "copyright": {
      "type": "string"
    },
    "bottomLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    }
  }
}
