{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Site-wide settings, navigation, footer, and SEO"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "siteDescription": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "navLinks": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "sub_nav_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sub-nav-item.sub-nav-item"
    },
    "headerCtaText": {
      "type": "string"
    },
    "headerCtaUrl": {
      "type": "string"
    },
    "footerDescription": {
      "type": "text"
    },
    "footerColumns": {
      "type": "component",
      "component": "shared.footer-column",
      "repeatable": true
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    },
    "copyright": {
      "type": "string"
    },
    "bottomLinks": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    }
  }
}
