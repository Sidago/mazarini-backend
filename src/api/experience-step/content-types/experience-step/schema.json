{
  "kind": "collectionType",
  "collectionName": "experience_steps",
  "info": {
    "singularName": "experience-step",
    "pluralName": "experience-steps",
    "displayName": "Experience Step",
    "description": "Individual steps in the circular experience journey"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "ctaText": {
      "type": "string"
    },
    "ctaUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    }
  }
}
