{
  "kind": "singleType",
  "collectionName": "news_pages",
  "info": {
    "singularName": "news-page",
    "pluralName": "news-pages",
    "displayName": "News Page",
    "description": "News listing page settings and featured articles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "pageTitle": {
      "type": "string",
      "required": true
    },
    "pageDescription": {
      "type": "text"
    },
    "featuredNews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news.news"
    },
    "featuredCTA": {
      "type": "string"
    }
  }
}
