{
  "kind": "singleType",
  "collectionName": "award_pages",
  "info": {
    "singularName": "award-page",
    "pluralName": "award-pages",
    "displayName": "Award Page",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroTitle": { "type": "string" },
    "heroText": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroWatermark": { "type": "string" },

    "peopleTitle": { "type": "string" },
    "peopleText": { "type": "text" },
    "peopleCtaText": { "type": "string" },
    "peopleCtaUrl": { "type": "string" },

    "knowledgeTitle": { "type": "string" },
    "knowledgeDescription": { "type": "text" },
    "knowledgeWatermark": { "type": "string" },
    "fieldMembers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::team.team"
    },

    "challengesTitle": { "type": "string" },
    "challengesDescription": { "type": "text" },
    "challengeCards": {
      "type": "component",
      "repeatable": true,
      "component": "award.challenge-card"
    },

    "textColumns": {
      "type": "component",
      "repeatable": true,
      "component": "award.text-column"
    },

    "journeyTitle": { "type": "string" },
    "journeyText": { "type": "text" },
    "journeyImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "journeyCtaText": { "type": "string" },
    "journeyCtaUrl": { "type": "string" },

    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
