{
  "kind": "collectionType",
  "collectionName": "expertises",
  "info": {
    "singularName": "expertise",
    "pluralName": "expertises",
    "displayName": "Expertise",
    "description": "Expertise areas with icon and image"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "icon": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
